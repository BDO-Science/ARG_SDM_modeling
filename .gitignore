# RStudio / R session state
.Rproj.user
.Rhistory
.RHistory
.RData
.Ruserdata
.RDataTmp*

# Documents are kept alongside the repo, not in it
*.pptx
*.docx
*.pdf

# Figures belong in figures/ ; keep stray root-level renders out
/*.png

# Quarto/knitr render output — regenerate from the .qmd sources in analysis/
*_files/
/analysis/*.html
/analysis/math.html
/analysis/equations.html

# Stray device output from headless Rscript runs
Rplots.pdf

# Manuscript-revision working notes.
# The technical record of model changes belongs in the repo (see
# docs/spawn-timing.md); the manuscript-side breadcrumb trail - reviewer
# responses, document editing checklists, revision audit logs - does not.
# Those live alongside the manuscript in the project folder, not here.
MANUSCRIPT_*.md
REVISION_FINDINGS.md
OUTSTANDING_ITEMS.md
*_DISCLOSURE.md
revision_notes/

# Manuscript editing checklists live alongside the documents, not in the repo
# (same rule as the retired OUTSTANDING_ITEMS.md / handoff notes above).
docs/EDIT_LIST_*.md

# Talks live alongside the repo, not in it - same rule as the manuscript.
# analysis/presentation_bdsc.R IS tracked (it regenerates the figures from
# committed model output); its rendered figures and the deck are not. The
# life-stage illustrations under figures/bdsc/lifecycle/ are INPUTS to that
# script, so they are tracked.
presentations/
figures/bdsc/*
!figures/bdsc/lifecycle/
figures/bdsc/lifecycle/_unused_*

# Collaborator delivery bundles; extract what is needed into data_raw/ instead
/ARG SDM revision.zip

# Scenario-year folders (app_data/<year>/) get re-run whenever a deliverable is
# revised; their simulated redd sets (~15 MB a run) are reproducible from the
# seed on a full precompute run and are not tracked. The published 2025 run in
# the flat app_data/ keeps its copies.
SalmonCountR/app_data/*/sim_future.rds
SalmonCountR/app_data/*/sim_redds.rds
